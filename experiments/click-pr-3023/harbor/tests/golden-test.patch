@@ -0,0 +1,34 @@
+import subprocess
+import sys
+
+
+def test_affected_modules_do_not_directly_import_shutil() -> None:
+    script = """
+import builtins
+
+found_imports = set()
+real_import = builtins.__import__
+
+def tracking_import(module, locals=None, globals=None, fromlist=None, level=0):
+    rv = real_import(module, locals, globals, fromlist, level)
+    if globals and globals.get("__name__", "").startswith("click") and level == 0:
+        found_imports.add(module)
+    return rv
+
+builtins.__import__ = tracking_import
+import click._termui_impl
+import click.formatting
+import click.testing
+raise SystemExit(1 if "shutil" in found_imports else 0)
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", script],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, (
+        "Click helper modules directly imported shutil\n"
+        f"stdout: {result.stdout}\n"
+        f"stderr: {result.stderr}"
+    )
