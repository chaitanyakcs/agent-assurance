{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.agent/schemas/v0/evidence.schema.json",
  "title": "Agent Assurance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "task", "executor", "outcome", "verification"],
  "properties": {
    "apiVersion": {"const": "assurance.agent/v0"},
    "kind": {"const": "Evidence"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}}
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "configuration"],
      "properties": {
        "type": {"enum": ["agent", "human"]},
        "provider": {"type": "string"},
        "agent": {"type": "string"},
        "model": {"type": "string"},
        "configuration": {"type": "string", "minLength": 1},
        "configuration_digest": {"type": "string"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["success", "failure", "partial", "aborted"]},
        "duration_seconds": {"type": "number", "minimum": 0},
        "cost": {"type": "number", "minimum": 0},
        "notes": {"type": "string"}
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "result"],
        "properties": {
          "type": {"enum": ["test", "lint", "typecheck", "static_analysis", "security", "behavioral", "reviewer", "human", "other"]},
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "warning", "not_run"]},
          "independent": {"type": "boolean"},
          "artifact": {"type": "string"},
          "details": {"type": "string"}
        }
      }
    }
  }
}
